{
  "project": {
    "name": "PSO-UNet-Image-Segmentation",
    "phase": 1,
    "seed": 42
  },
  "dataset": {
    "name": "Oxford-IIIT Pet",
    "root": "data/raw",
    "image_size": 128,
    "validation_ratio": 0.2,
    "batch_size": 16
  },
  "model": {
    "name": "CompactUNet",
    "input_channels": 3,
    "output_channels": 1,
    "encoder_channels": [16, 32, 64, 128],
    "bottleneck_channels": 256,
    "dropout": 0.1
  },
  "training": {
    "epochs": 8,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "optimizer": "AdamW",
    "bce_weight": 0.5,
    "dice_weight": 0.5,
    "prediction_threshold": 0.5,
    "device": "auto"
  },
  "pso": {
    "enabled": true,
    "particles": 3,
    "evaluation_rounds": 2,
    "candidate_epochs": 2,
    "inertia": 0.7,
    "cognitive": 1.5,
    "social": 1.5,
    "learning_rate_bounds": [0.0001, 0.003],
    "dropout_bounds": [0.0, 0.3],
    "weight_decay_bounds": [0.000001, 0.001]
  }
}
